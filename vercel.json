{
    "framework": "nextjs",
    "buildCommand": "cd node_code/antnet-frontend && npm install && npm run build",
    "outputDirectory": "node_code/antnet-frontend/.next",
    "installCommand": "cd node_code/antnet-frontend && npm install",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://antnet.zeabur.app/api/:path*"
        }
    ]
}